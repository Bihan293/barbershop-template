# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую.
# Свой ID можно узнать командой /id в боте.
ADMIN_IDS=

# Веб-сервер (сайт + API)
HOST=0.0.0.0
PORT=8080

# Часовой пояс барбершопа — влияет на даты, слоты и напоминания
TIMEZONE=Asia/Almaty

# SQLite (если DATABASE_URL пуст)
DB_PATH=data/barbershop.db
MEDIA_DIR=media

# PostgreSQL / Neon. Если заполнено — SQLite не используется для данных.
# Фото всё равно остаются файлами в MEDIA_DIR.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Публичный адрес сайта. Нужен для webhook и ссылок в уведомлениях.
PUBLIC_URL=
SITE_URL=

# Включить webhook вместо polling (нужен PUBLIC_URL и HTTPS-прокси)
USE_WEBHOOK=false

# Секрет webhook. Если пусто — сгенерируется автоматически при запуске.
WEBHOOK_SECRET=

# Токен для /api/metrics. Если пусто — доступ только с localhost.
# Для Railway задайте длинную случайную строку и открывайте /api/metrics?token=...
METRICS_TOKEN=
